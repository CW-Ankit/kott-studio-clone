# Kott Studio Environment Configuration

# Transactional Email Dispatch (Resend: https://resend.com)
# Leave empty in local development to log inquiries to terminal console
RESEND_API_KEY=

# Inbound email destination where letters should be delivered
CONTACT_EMAIL=hello@kott.studio

# Verified sender address configured in Resend (e.g., inquiries@yourdomain.com)
FROM_EMAIL=onboarding@resend.dev
